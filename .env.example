# ==============================================================================
# StartIQ Environment Configuration
# ==============================================================================

# LLM Providers (Optional - If omitted, StartIQ uses the built-in Mock Engine)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Ports Configuration
AI_SERVICE_PORT=8000
AI_SERVICE_URL=http://localhost:8000
PORT=5000
BACKEND_URL=http://localhost:5000

# Database Configuration
# Leave blank to use the zero-config local SQLite database (startiq.db)
# Or provide a PostgreSQL connection URI (e.g. Neon.tech / Supabase / local PostgreSQL):
# DATABASE_URL=postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/startiq?sslmode=require
DATABASE_URL=
